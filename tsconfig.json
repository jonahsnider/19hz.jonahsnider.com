{
	"extends": "astro/tsconfigs/strictest",
	"compilerOptions": {
		"erasableSyntaxOnly": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"contentMappers": [
		{
			"package": "@astrojs/ts-content-mapper",
			"extensions": [".astro"]
		}
	],
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"]
}
